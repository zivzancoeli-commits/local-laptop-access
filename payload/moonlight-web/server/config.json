{
  "data_storage": {
    "type": "json",
    "path": "server/data.json",
    "session_expiration_check_interval": {
      "secs": 300,
      "nanos": 0
    }
  },
  "webrtc": {
    "ice_servers": [],
    "ice_server_script": null,
    "port_range": null,
    "nat_1to1": null,
    "network_types": [
      "udp4",
      "udp6"
    ],
    "include_loopback_candidates": false
  },
  "web_server": {
    "bind_address": "0.0.0.0:8080",
    "certificate": null,
    "url_path_prefix": "",
    "session_cookie_secure": false,
    "session_cookie_expiration": {
      "secs": 86400,
      "nanos": 0
    },
    "first_login_create_admin": true,
    "first_login_assign_global_hosts": true,
    "default_user_id": null,
    "default_role_id": null,
    "forwarded_header": null
  },
  "moonlight": {
    "default_http_port": 47989,
    "pair_device_name": "host"
  },
  "streamer_path": "streamer",
  "log": {
    "level_filter": "INFO",
    "file_path": "logs/web-server.log",
    "dev_venator": false
  },
  "default_settings": null
}