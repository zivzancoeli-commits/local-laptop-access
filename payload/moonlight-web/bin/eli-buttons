#!/bin/bash
# User-level check for the Turn On / Turn Off helper.
# kill -0 on the root process fails with "Operation not permitted".
set -u
DIR="${HOME}/.config/moonlight-web"
PIDFILE="$DIR/eli-switch.pid"
case "${1:-}" in
  ready)
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    [ -n "$pid" ] || exit 1
    if ps -p "$pid" -o command= 2>/dev/null | grep -q 'eli-internet-root service'; then
      exit 0
    fi
    launchctl print system/dev.moonlight.eli-internet 2>/dev/null | grep -q 'state = running'
    ;;
  *)
    echo "usage: eli-buttons ready" >&2
    exit 2
    ;;
esac
